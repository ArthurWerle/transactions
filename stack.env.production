# Production stack.env — deploy as "stack.env" in Portainer
# Container names
POSTGRES_CONTAINER_NAME=transactions_postgres
SERVICE_CONTAINER_NAME=transaction-service-v2

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_PROD
POSTGRES_DB=transactions
POSTGRES_PORT=5432

# App DB connection
DB_HOST=transactions_postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_PROD
DB_NAME=transactions

# App
SERVER_PORT=3000
SERVICE_PORT=3000
LOG_LEVEL=info
