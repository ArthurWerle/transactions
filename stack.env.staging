# Staging stack.env — deploy as "stack.env" in Portainer
# Container names (must differ from production)
POSTGRES_CONTAINER_NAME=transactions_postgres_staging
SERVICE_CONTAINER_NAME=transaction-service-v2-staging

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STAGING
POSTGRES_DB=transactions
POSTGRES_PORT=5433

# App DB connection
DB_HOST=transactions_postgres_staging
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STAGING
DB_NAME=transactions

# App
SERVER_PORT=3000
SERVICE_PORT=3001
LOG_LEVEL=debug
